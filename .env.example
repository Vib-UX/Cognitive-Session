# Base match draw. Set the consumer address to hold a chess pair until VRF fulfills.
# CRE_SIMULATE=1 spawns `cre workflow simulate` for each pair. Do not set CRE_BROADCAST on a funded subscription.
SESSION_MATCH_DRAW_ADDRESS=
VRF_SUBSCRIPTION_ID=
CRE_SIMULATE=0
CRE_BROADCAST=0
CRE_TARGET=base
CRE_WORKFLOW_DIR=cre/match-draw
