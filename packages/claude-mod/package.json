{
  "name": "@hlvuser/session",
  "version": "0.1.0",
  "description": "Claude Code mod: play chess or flappy with another live Session. The relay pairs the two players.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vib-UX/Cognitive-Session.git",
    "directory": "packages/claude-mod"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "session-claude-mod": "./bin/plugin-dir.js"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "bin",
    "hooks",
    "skills",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"console.log('claude mod ships register.js')\"",
    "prepublishOnly": "pnpm --dir ../.. --filter @session/core build && rm -rf vendor && cp -R ../core/dist vendor",
    "postpublish": "rm -rf vendor",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "bonjour-service": "^1.3.0",
    "chess.js": "^1.4.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  }
}
